//-            270
//-            x  x     
//-         x        x  
//-  180   x          x  0
//-        x          x 
//-         x        x  
//-            x  x     
//-             90

mixin fadeIn(delay=0, offset="10 0")
    animateTransform(
        attributeName="transform"
        type="translate"
        dur=`.2s`
        from=offset
        to="0 0"
        calcMode="spline"
        keySplines="0.65, 0, 0.35, 1"
        fill="freeze"
        begin=`${delay}s`
    )

    animate(
        attributeName="opacity"
        from=0
        to=1
        dur=".5s"
        calcMode="spline"
        keyTimes="0;1"
        keySplines="0.65, 0, 0.35, 1"
        fill="freeze"
        begin=`${delay}s`
    )

style.
    line {
        stroke: #222222;
        stroke-width: 4px;
        stroke-linecap: butt;
    }

    circle {
        stroke-linecap: butt
    }

//- style=getGradientColors(options.languagesPerSlide).map((color, i) => `text.l-${i} { fill: ${color} } line.l-${i} { stroke: ${color} }`).join("\n")

- const r = 120, w = 25, count = options.dashesCount;
- const cx = 800, cy = 150;
each languages, li in slides
    //- Dashed Donut Chart
    - let langIndex = languages.length - 1;
    - let zoneIndex = 0;
    - const gradient = getGradientColors(languages.length);


    g(opacity="0")

        +text(`${li + 1}`, 790, 150, 24, 'right', 'center', '#fff')

        each _, i in [...Array(count)]
            - let style = `stroke:${gradient[langIndex]}`;
            - if(languages[langIndex].size + 1 === ++zoneIndex) langIndex--, zoneIndex = 0, style = null

            line(
                style=style
                x1=(cx + Math.cos(getAngleByOffset(i, count)) * r)
                y1=(cy + Math.sin(getAngleByOffset(i, count)) * r)
                x2=(cx + Math.cos(getAngleByOffset(i, count)) * (r - w))
                y2=(cy + Math.sin(getAngleByOffset(i, count)) * (r - w))
            )

        //- labels
        each lang, i in languages
            -
                const padding_deg = 48;
                const angle = getAngleByOffset(languages.length - i - 1, languages.length, 90 + padding_deg, 270 - padding_deg)
                const size = range(5, 15, 32, 10, languages.length)

            g(transform="translate(20 0)")
                +text(
                    lang.lang.slice(0, 27) + `${lang.lang.length > 27 ? "..." : ""} `,
                    (cx + Math.cos(angle) * (r + 20)) - 80,
                    (cy + Math.sin(angle) * (r + 20)),
                    size,
                    'right', 'center', gradient[i] || '#fff'
                )

                +text(
                    lang.sizep,
                    (cx + Math.cos(angle) * (r + 20)) - 10,
                    (cy + Math.sin(angle) * (r + 20)),
                    (size * 0.625),
                    'right', 'center', '#444444'
                )

                - const delay = (i * .02)
                animateTransform(
                    id=`txt${i}_op`
                    attributeName="transform"
                    type="translate"
                    dur=`${options.slideDuration + .5}s`
                    values="20 0; 0 0; 0 0; -40 0"
                    keyTimes=`0;${.5 / options.slideDuration}; ${1 - .5 / options.slideDuration}; 1`
                    calcMode="spline"
                    keySplines="0.16 1 0.3 1; 0.16, 1, 0.3, 1; 0.7, 0, 0.84, 0"
                    begin=`${(options.slideDuration + .5) * li + delay}s;lg${li}_op.end+${(options.slideDuration + .5) * (slides.length - 1) + delay}s`
                )

        animate(
            id=`lg${li}_op`
            attributeName="opacity"
            dur=`${options.slideDuration + .5}s`
            values="0; 1; 1; 0"
            keyTimes=`0;${.5 / options.slideDuration}; ${1 - .5 / options.slideDuration}; 1`
            begin=`${(options.slideDuration + .5) * li}s;lg${li}_op.end+${(options.slideDuration + .5) * (slides.length - 1)}s`
        )


    //- slider progress bar
    -
        const mini_circle_r = r - w - 15
        const circumference = 2 * Math.PI * mini_circle_r;
        const percent = 100;

    circle.progress_outer(cx=cx cy=cy r=mini_circle_r stroke="#222222" stroke-width=3)
    circle.progress_inner(cx=cx cy=cy r=mini_circle_r stroke="#ffffff" stroke-width=3
        stroke-dasharray=circumference
        transform=`rotate(270 ${cx} ${cy})`
    )
        animate(id="sp_sdf" dur=`${options.slideDuration}s` attributeName="stroke-dashoffset" begin="0s;sp_op0.end" values=`${circumference - (0.5 * circumference)};0`)
        animate(id="sp_op0" dur=".5s" attributeName="opacity" begin="sp_sdf.end" from="1" to="0")
        animate(id="sp_op1" dur=".5s" attributeName="opacity" begin="0s;sp_op0.end" from="0" to="1")

