    line(x1=800-30 y1=330+24+5+6 x2=800-30 y2=330+24+2 style="stroke:#ffffff;stroke-width:1px;")
    rect(x=800-30-180 y=330+24+5 width="180px" height="6px" stroke="#ffffff" stroke-width="1")
    rect(x=800-30-180+1 y=330+24+5+1 width=0 height="4px" fill="url(#gradient)")
        animate(
            attributeName="width"
            from="0"
            to=starsProgressBarWidth
            dur="1s"
            calcMode="spline"
            keyTimes="0;1"
            keySplines="0.65, 0, 0.35, 1"
            fill="freeze"
        )
    +fadeIn(.2)

