//- text
-
    const formatNumber = (value, opts = {}) => {
        const options = { notation: "compact", maximumFractionDigits: 2, ...opts };
        const formatted = Intl.NumberFormat('en-US', options).format(value);
        return formatted === 'NaN' ? 'N/A' : formatted;
    }

    let maxStars = formatNumber(valxp(total.stars));
    let stars = formatNumber(total.stars);
    let views = formatNumber(total.views);
    let forks = formatNumber(total.forks);
    const starsProgressBarWidth = range(0, valxp(total.stars), 0, 178, total.stars);

