mixin generateStyles()
    each color, i in colors
        | .text.l-#{i}, .line.l-#{i} { color: #{color}; stroke: #{color}; }

mixin text(str="empty string", x=0, y=0, size=32, halign, valign, fill)
    -halign = ['left', 'center', 'right'].includes(halign) ? halign : 'left';
    -valign = ['top', 'center', 'bottom'].includes(valign) ? valign : 'top';

    -
        let offsetX = 0;
        switch (halign) {
            case 'left': break;
            case 'center': offsetX = str.length * size / 4; break;
            case 'right': offsetX = str.length * size / 2; break
        }

        let offsetY = 0;
        switch (valign) {
            case 'top': break;
            case 'center': offsetY = size / 2; break;
            case 'bottom': offsetY = size; break
        }

    g(transform=`translate(${x - offsetX}, ${y - offsetY})`)
        each c, i in str2unicode(str)
            use.symbol(
                x=(size / 2 * i)
                y=0
                href=`#u${c}`
                fill=fill
                width=size / 2
                height=size
            )

-
    const lerp = (x, y, a) => x * (1 - a) + y * a;
    const clamp = (a, min = 0, max = 1) => Math.min(max, Math.max(min, a));
    const invlerp = (x, y, a) => clamp((a - x) / (y - x));
    const range = (x1, y1, x2, y2, a) => lerp(x2, y2, invlerp(x1, y1, a));
    const valxp = n => {
        n = n << 0;
        let len = n.toString().length;
        return n < 5 * 10 ** (len - 1) ? 5 * 10 ** (len - 1) : 10 ** len;
    }; // set goal for stars (1 -> 5 -> 10 -> 50 -> 100 -> 500 -> 1000 -> 5000 ...)

    const deg2rad = deg => (Math.PI / 180) * deg;
    const getAngleByOffset = (offset, steps = 1, start = 90, end = 270) => deg2rad(start + (offset / Math.max(steps - 1, 1)) * (end - start));
    const str2unicode = (str) => {
        const unicodes = [];
        for (let i = 0; i < str.length; i++) {
            const hex = str.charCodeAt(i).toString(16).padStart(4, '0');
            unicodes.push(String(hex));
        }
        return unicodes;
    }

    const baseColors = ["#8EB6F5", "#C58FFF", "#F58EE0", "#FFBB88", "#FDFDFE"];


