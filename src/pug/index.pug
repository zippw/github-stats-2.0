        -
            function getGradientColors(numColors) {
                if (numColors <= 0) return [];
                if (numColors === 1) return [baseColors[Math.floor(baseColors.length / 2)]];
                if (numColors <= baseColors.length) return baseColors.slice(0, numColors);

                const rgbColors = baseColors.map(hexToRgb);

                // Creating evenly distributed positions for new colors
                const positions = [];
                for (let i = 0; i < numColors; i++) {
                    positions.push(i / (numColors - 1));
                }

                // Интерполируем цвета
                const result = [];
                for (const pos of positions) {
                    // find between which colors from the base set the current position is located
                    const segment = pos * (rgbColors.length - 1);
                    const index = Math.floor(segment);
                    const ratio = segment - index;

                    if (index >= rgbColors.length - 1) {
                        result.push(baseColors[baseColors.length - 1]);
                    } else {
                        // Interpolating between two adjacent colors
                        const color1 = rgbColors[index];
                        const color2 = rgbColors[index + 1];
                        const interpolated = {
                            r: Math.round(color1.r + ratio * (color2.r - color1.r)),
                            g: Math.round(color1.g + ratio * (color2.g - color1.g)),
                            b: Math.round(color1.b + ratio * (color2.b - color1.b))
                        };
                        result.push(rgbToHex(interpolated));
                    }
                }

                return result;
            }

            function hexToRgb(hex) {
                const r = parseInt(hex.substring(1, 3), 16);
                const g = parseInt(hex.substring(3, 5), 16);
                const b = parseInt(hex.substring(5, 7), 16);
                return { r, g, b };
            }

            function rgbToHex({ r, g, b }) {
                return `#${((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toUpperCase()}`;
            }


